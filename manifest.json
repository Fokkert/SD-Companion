{
  "manifest_version": 3,
  "name": "SD Companion",
  "short_name": "SD Companion",
  "description": "API-first Jira Service Desk automation with profiles, rules, schedules, alarms and multi-server monitoring.",
  "version": "2.4.1",
  "version_name": "V2",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "tabs",
    "sidePanel",
    "scripting",
    "offscreen",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "SD Companion",
    "default_popup": "src/ui/app/app.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png"
  },
  "side_panel": {
    "default_path": "src/ui/app/sidepanel.html"
  }
}
